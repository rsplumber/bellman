{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=your_database;Username=your_username;Password=your_password;Pooling=true;"
  },
  "Kundera": {
    "BaseUrl": "http://localhost:1002",
    "ServiceSecret": "your_service_secret_here"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "your_exchange_name"
  },
  "ElasticApm": {
    "ServiceName": "YourServiceName",
    "LogLevel": "Debug",
    "ServerUrl": "http://localhost:8200",
    "TransactionSampleRate": 1.0
  }
}
